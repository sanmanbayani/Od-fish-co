modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SUPABASE_DB_HOST = "aws-0-ap-northeast-2.pooler.supabase.com"
SUPABASE_DB_USER = "postgres.myvzslskdpzftvescrmw"
EXPO_PUBLIC_DOMAIN = "od-fish-api.onrender.com"
