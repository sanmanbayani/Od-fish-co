auto-install-peers=false
strict-peer-dependencies=false

# Windows cannot build the Android app when paths get long. pnpm names every
# folder in node_modules/.pnpm `<package>@<version>_<32-char hash>`, and the
# native (C++) build then nests CMake object files far below that. CMake refuses
# to write an object file whose full path exceeds 250 characters, which is what
# breaks `:react-native-screens:buildCMakeDebug` and friends on Windows.
#
# Capping the virtual-store name length trims ~20 characters off every native
# module's build path. Linux and macOS are unaffected either way.
#
# Changing this only takes effect on a fresh install: delete node_modules and
# run `pnpm install` again.
virtual-store-dir-max-length=40
