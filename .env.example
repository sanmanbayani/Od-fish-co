# OD Fish Co. — environment variables
# Copy to .env and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------- required

# Postgres connection string.
#   Replit dev : provided automatically.
#   Supabase   : Project Settings → Database → Connection string → URI.
#                Use the *transaction pooler* host (port 6543) on serverless
#                hosts such as Vercel; use the direct host (port 5432) on a
#                long-lived server and for schema pushes.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Signs session cookies and bearer tokens. Any long random string.
# Changing it signs every existing session out.
SESSION_SECRET=

# Must be set explicitly on every deployment. An unset value is treated as
# public, which is the safe direction but disables development conveniences.
NODE_ENV=production


# ------------------------------------------------- cross-origin web deployment
#
# Only needed when the web app is served from a different domain than the API
# (e.g. the site on Vercel, the Express server on Railway). On a single-host
# deployment leave both unset — requests stay same-origin and SameSite=Lax
# keeps the session cookie safe from third-party sites by default.

# Comma-separated browser origins allowed to call this API with credentials.
# An allow-list, not a wildcard: reflecting any origin while allowing cookies
# lets any website make authenticated requests as a signed-in admin.
# WEB_ORIGINS=https://odfishco.in,https://www.odfishco.in

# Relax session cookies to SameSite=None; Secure so they survive cross-site
# requests. The API refuses to start with this on unless WEB_ORIGINS is set.
# CROSS_SITE_COOKIES=true

# Set on the WEB app's build (Vercel project env), not the API's. Absolute URL
# of the API, no trailing slash. Leave unset for same-origin deployments.
# VITE_API_BASE_URL=https://api.odfishco.in


# ---------------------------------------------------------------- database TLS

# PEM-encoded CA certificate for the database provider. Without it the
# connection is still encrypted but the server identity is not verified, and
# the API logs a warning at startup. Supabase publishes its CA in the
# dashboard under Database → SSL Configuration.
# DATABASE_CA_CERT=

# Max Postgres connections per process. Set to 1 on serverless platforms
# (Vercel, Lambda) where many short-lived instances each open a pool.
# DATABASE_POOL_MAX=10


# ------------------------------------------------------- temporary demo mocks
#
# Both are OFF by default and both must be removed before real customers or
# real money. With neither set, the API fails closed: OTP requests return
# `sms_not_configured` and online payment returns `gateway_not_configured`.

# Stand-in login while DLT/TRAI SMS registration is pending. When set to a
# 6-digit code, ANY phone number can sign in using that one shared code.
# Treat it as a staging password: tell testers, rotate freely, never launch
# with it. The code is never echoed in an API response on a public
# environment — the caller has to be told it out of band.
# AUTH_MOCK_OTP=246810

# Simulated payment settlement while gateway KYC is pending. When true, the
# customer-callable settle route marks prepaid orders PAID without any money
# moving. Deliberately separate from AUTH_MOCK_OTP so enabling demo logins
# does not also enable free checkout.
# PAYMENTS_MOCK=true
